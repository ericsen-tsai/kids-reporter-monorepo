{
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/draft-editor",
    "packages/draft-renderer",
    "packages/cms",
    "packages/frontend",
    "packages/routing-ui",
    "packages/api-gateway",
    "packages/cronjob",
    "packages/image-resizer"
  ],
  "scripts": {
    "prepare": "husky",
    "update": "yarn changeset && yarn changeset version",
    "dev:cms": "cd packages/cms && dotenv -e .env.local -- yarn dev",
    "dev:frontend": "cd packages/frontend && yarn dev --port 3001",
    "dev:api-gateway": "cd packages/api-gateway && dotenv -e .env.local -- yarn dev",
    "build:routing-ui": "cd packages/routing-ui && yarn build",
    "lint:check": "yarn workspaces run lint:check",
    "type-check": "yarn workspaces run type-check",
    "check:all": "yarn lint:check && yarn type-check"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.10",
    "@babel/core": "^7.18.5",
    "@babel/eslint-parser": "^7.11.4",
    "@babel/preset-env": "^7.18.2",
    "@babel/preset-react": "^7.17.12",
    "@babel/preset-typescript": "^7.17.12",
    "@babel/types": "^7.28.4",
    "@changesets/cli": "^2.27.1",
    "@eslint/eslintrc": "^3.3.1",
    "@types/draft-js": "^0.11.10",
    "@types/lodash": "^4.14.197",
    "@types/node": "^20.19.5",
    "@types/react": "^18.3.7",
    "@types/styled-components": "^5.1.34",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-plugin-file-loader": "^2.0.0",
    "babel-plugin-inline-react-svg": "^2.0.1",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "webpack-dev-server": "^4.15.1",
    "@types/babel__core": "^7.20.5",
    "@types/eslint-config-prettier": "^6.11.3"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": "eslint --config eslint.config.mjs --cache --fix"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "version": "0.0.0",
  "packageManager": "yarn@1.22.19"
}
