# Content API Environment Variables
# Copy this file to .env.local and update values as needed.

PORT=8081
CORS_ALLOW_ORIGINS=http://localhost:3001
GO_API_ENV=staging
GCS_ORIGIN=https://kids-storage.twreporter.org
GCP_PROJECT_ID=kids-reporter
GO_API_JWT_SECRET=
GO_API_JWT_ISSUER=
GO_API_JWT_AUDIENCE=
IMAGES_STORAGE_PATH=public/images
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgres://user:password@localhost:5432/kids

# Optional
REQUEST_TIMEOUT_MS=10000
